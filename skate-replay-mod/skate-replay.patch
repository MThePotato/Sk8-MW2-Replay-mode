+        if buttons & BTN_DPAD_U != 0
+            || (arrows && keys.pressed(KeyCode::ArrowUp))
+            || keys.pressed(KeyCode::PageUp)
+        {
+            v_dir += 1;
+        }
+        if buttons & BTN_DPAD_D != 0
+            || (arrows && keys.pressed(KeyCode::ArrowDown))
+            || keys.pressed(KeyCode::PageDown)
+        {
+            v_dir -= 1;
+        }

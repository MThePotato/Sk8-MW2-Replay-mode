+
+        // Prompts follow whichever device was used last.
+        if pressed != 0
+            || lstick[0].hypot(lstick[1]) > 0.5
+            || rstick[0].hypot(rstick[1]) > 0.5
+            || trig[0] > 0.5
+            || trig[1] > 0.5

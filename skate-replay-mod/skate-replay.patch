+impl Repeat {
+    fn tick(&mut self, dir: i8, dt: f32) -> i8 {
+        if dir == 0 {
+            self.dir = 0;
+            self.timer = 0.0;
+            return 0;
+        }
+        if dir != self.dir {
+            self.dir = dir;
+            self.timer = 0.35;
+            return dir;
+        }
+        self.timer -= dt;
+        if self.timer <= 0.0 {
+            self.timer = 0.07;
+            return dir;
+        }
+        0
+    }

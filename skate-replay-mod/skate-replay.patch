+            host.hold_render_cancel = Hold::default();
+            render.abort_pipe();
+            render.rendering = false;
+            render.capturing = false;
+            render.finished = false;
+            mode.replaying = false;
+            mode.rendering = false;
+            mode.hide_hud = false;
+            ui_draw.0 = true;

+    }
+    if render.finished && !render.capturing {
+        render.finished = false;
+        mode.rendering = false;
+        mode.hide_hud = false;
+        ui_draw.0 = true;
+    }
+    if mode.replaying {
+        let dt = time.delta_secs().min(0.1);
+        let last_time = host.recorded.last().map(|f| f.time_secs).unwrap_or(0.0);

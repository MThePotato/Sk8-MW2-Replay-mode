+/// Maps a playback speed (0.125x..4x) to a green->red segment colour.
+fn speed_color(speed: f32) -> Color {
+    let t = ((speed - 0.125) / (4.0 - 0.125)).clamp(0.0, 1.0);
+    Color::srgb(
+        0.30 + (0.95 - 0.30) * t,
+        0.85 + (0.30 - 0.85) * t,
+        0.40 + (0.25 - 0.40) * t,
+    )
+}

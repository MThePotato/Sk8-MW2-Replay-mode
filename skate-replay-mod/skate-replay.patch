+                    shutter,
+                    crf: mode.render_crf,
+                    scale: mode.render_scale.clone(),
+                    portrait: mode.portrait,
+                    cinematic: mode.cinematic,
+                    name: mode.render_name.clone(),
+                    dir,
+                });

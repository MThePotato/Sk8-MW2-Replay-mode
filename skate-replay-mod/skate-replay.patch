+            let starts: Vec<usize> = REPLAY_MENU
+                .iter()
+                .enumerate()
+                .filter(|(_, item)| item.section().is_some())
+                .map(|(i, _)| i)
+                .collect();
+            if pressed & BTN_RB != 0 && !starts.is_empty() {
